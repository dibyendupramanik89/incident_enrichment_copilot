# Example environment variables for incident_enrichment_copilot

# App settings
LOG_LEVEL=INFO
PORT=8080

# Alarm API
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=demo-token

# MCP services
MCP_ALARM_URL=http://localhost:9000
MCP_TICKETING_URL=http://localhost:9001
MCP_TIMEOUT_SECONDS=20

# LLM — Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM — Option B: Ollama (local, no API key needed)
# Set OLLAMA_MODEL to use Ollama instead of OpenAI
# Run: ollama serve  then  ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Vector store settings
VECTOR_STORE_PATH=./rag/.vector_store
RAG_DOCUMENTS_DIR=./rag/documents
